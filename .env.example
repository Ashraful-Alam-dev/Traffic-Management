# Copy to .env and fill in. Never commit .env.

# Runtime DB connection (pooled in production, e.g. Neon pooler with ?pgbouncer=true)
DATABASE_URL="postgresql://bus:bus@localhost:5432/bus"
# Direct DB connection, used only by prisma migrate
DIRECT_URL="postgresql://bus:bus@localhost:5432/bus"
# Separate DB for integration tests (wiped before each test run)
DATABASE_URL_TEST="postgresql://bus:bus@localhost:5432/bus_test"

# Random 32+ byte secrets: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-bytes"
CRON_SECRET="change-me-too-another-long-random-string"

# Comma-separated origins allowed for CORS. Empty = no cross-origin access.
ALLOWED_ORIGINS=""

# Demo account passwords used by the seed (required when NODE_ENV=production)
DEMO_DRIVER_PASSWORD="driver-demo-123"
DEMO_AUTHORITY_PASSWORD="authority-demo-123"

NODE_ENV="development"
